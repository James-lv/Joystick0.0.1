    <Compile Include="read_button_class.py" />
    <Compile Include="read_force.py" />
    <Compile Include="read_pos_class.py" />
    <Compile Include="set_damping.py" />
    <Compile Include="spring_force.py" />
    <Compile Include="stickshake.py" />
    <Compile Include="target_torque.py" />
    <Compile Include="trim_position.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="random_icon.ico" />
    <Content Include="udpconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="env\">
      <Id>env</Id>
      <Version>3.10</Version>
      <Description>env (Python 3.10 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
