<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>a77ea0f3-b130-4752-a998-2a2fc9f8bc8b</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>joystick.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>joystick</Name>
    <RootNamespace>joystick</RootNamespace>
    <InterpreterId>MSBuild|env|$(MSBuildProjectFullPath)</InterpreterId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Axis_range_limits.py" />
    <Compile Include="brake.py" />
    <Compile Include="External_force_profile.py" />
    <Compile Include="force_offset.py" />
    <Compile Include="force_profile_class.py" />
    <Compile Include="friction_class.py" />
    <Compile Include="joystick.py" />
    <Compile Include="pitch_signal_generator.py" />
    <Compile Include="postioncontrol.py" />
    <Compile Include="postion_window.py" />
